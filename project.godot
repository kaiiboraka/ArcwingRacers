; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ResCleaner]

data/keep_list=Array[String]([])

[addons]

project_layer_names/output=2
project_layer_names/c#_namespace="ArcwingRacers"

[application]

config/name="ArcwingRacers"
run/main_scene="uid://ckbu050laq1kp"
config/features=PackedStringArray("4.7", "C#")
boot_splash/image="uid://d02b1b1s58j40"
config/icon="uid://caimmelb02tso"

[autoload]

SignalLens="*uid://mh4uahxfhah"
NetworkTime="*uid://cnqdxyjptkfvp"
NetworkTimeSynchronizer="*uid://bqt8q5icbv3lq"
NetworkEvents="*uid://bdmobxxptryj0"
NetworkPerformance="*uid://cqgf7aqmjfoa3"
NetworkRollback="*uid://gas743comroj"
WindowTiler="*uid://cmqjajhjgffm1"
NetworkSimulator="*uid://1y2ey1e6qjwr"
Noray="*uid://gu4bv4tgms3x"
PacketHandshake="*uid://tt3j25a05n7c"
LayerNames="*uid://cfuv1yauxwtgd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"
DebugManager="*uid://g77bng7caocf"
InputCollector="*res://Systems/Input/InputCollector.gd"
CameraRoot="*uid://btveng6akpeug"
EventBus="*res://Systems/Events/event_bus.gd"
Ui="*uid://dblpebgaxt1jb"
ScreenEffects="*uid://mdeofcf6dtj"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/size/extend_to_title=true
window/size/sharp_corners=true
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/icon="uid://cxanvdcmlwtu6"
window/physics_interpolation=false

[dotnet]

project/assembly_name="ArcwingRacers"

[editor_plugins]

enabled=PackedStringArray("res://addons/ColorPreview/plugin.cfg", "res://addons/Todo_Manager/plugin.cfg", "res://addons/arcwing_track_editor/plugin.cfg", "res://addons/explore-editor-theme/plugin.cfg", "res://addons/fancy_editor_sounds/plugin.cfg", "res://addons/fancy_folder_colors/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/godotresourcecleaner/plugin.cfg", "res://addons/layerNames/plugin.cfg", "res://addons/log/plugin.cfg", "res://addons/netfox.extras/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox.noray/plugin.cfg", "res://addons/netfox/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/plugin_refresher/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg", "res://addons/reload_current_scene/plugin.cfg", "res://addons/resource_namer/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://Content/": "pink",
"res://Content/Resources/": "red",
"res://Content/Scripts/": "purple",
"res://Systems/": "yellow",
"res://UI/": "teal",
"res://addons/": "gray"
}

